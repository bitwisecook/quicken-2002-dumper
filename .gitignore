.venv/
.ruff_cache/
__pycache__/
*.pyc
dist/
build/
*.egg-info/

# Publish only the reader, synthetic tests, build metadata and format note.
/*
!/.gitignore
!/LICENSE
!/README.md
!/pyproject.toml
!/uv.lock
!/src/
!/tests/
!/docs/
/docs/*
!/docs/file-format.md
/tests/*
!/tests/__init__.py
!/tests/support.py
!/tests/unit/
!/tests/vectors/

# Never publish user data, logs, credentials or generated databases.
*.[qQ][dD][fF]
*.[qQ][sS][dD]
*.[hH][cC][xX]
*.[qQ][iI][fF]
*.[oO][fF][xX]
*.[qQ][fF][xX]
*.[oO][dD][sS]
*.[cC][sS][vV]
*.sqlite*
*.db*
*.log*
*.jsonl
.env*
*.p8
*.pem
*.key
*.p12
*.pfx
credentials.json
.DS_Store
